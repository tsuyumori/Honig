  "description": "Lightweight rendering library for NeoForge and Fabric",
  "authors": ["Tsuyumori"],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/honig/icon.png",
